#!/bin/sh

logout(){
    bemenu="$(printf " Sleep  \n Shutdown  \n Logout  \n Restart  \n" \
	    | bemenu -H 20 --ch 24 --fn 'JetBrainsMono Nerd Font 11' -p 'debian  ' --tb '#2d2d2d' --tf '#f2777a' --fb '#2d2d2d' --ff '#6699cc' --nb '#2d2d2d' --nf '#747369' --hb '#2d2d2d' --hf '#d3d0c8' --ab '#2d2d2d' --af '#747369')"

    case $bemenu in
	" Sleep  " )  systemctl suspend ;;
	" Shutdown  " ) hyprshutdown -p 'shutdown -P 0' ;;
	" Logout  " ) hyprshutdown ;;
	" Restart  " ) hyprshutdown -p 'reboot'
    esac
}

_tmux(){
tmux ls 2> /dev/null
if [ $? = 1 ]; then
printf "Starting TMUX session\n" && \
    tmux -u new -s TMUX -d && \
    tmux rename-window -t TMUX:1 '    terminal ' && \
    tmux new-window -t TMUX && \
    tmux rename-window -t TMUX:2 '    file_manager ' && \
    tmux new-window -t TMUX && \
    tmux rename-window -t TMUX:3 '    text_editor ' && \
    tmux new-window -t TMUX && \
    tmux rename-window -t TMUX:4 '  󰎇  μsik ' && \
    tmux send-keys -t TMUX:2 'sleep 3 && while true; do; yazi && clear; done' C-m && \
    tmux send-keys -t TMUX:3 'while true; do; nvim; done' C-m && \
    tmux send-keys -t TMUX:4 'while true; do; ytm; done' C-m && \
    tmux select-window -t 1
else
    printf "TMUX is already running\n"
fi
}

case $1 in
    logout ) logout ;;
    tmux ) _tmux ;;
esac
