{
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "tray",
    "custom/volume",
    "clock"
  ],
  "hyprland/workspaces": {
	"format": "{icon}",
	"workspace-taskbar": "enable",
	"format-icons": {
		"1": "  一  ",
		"2": "  二  ",
		"3": "  三  ",
		"4": "  四  ",
		"5": "  五  ",
		"6": "  六  ",
		"7": "  七  ",
		"8": "  八  ",
		"9": "  九  "
	}
},
  "custom/volume": {
    "exec": "pamixer --get-volume-human",
    "interval": "once",
    "signal": 1,
    "format": "{}",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle; pkill -SIGRTMIN+1 waybar",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%; pkill -SIGRTMIN+1 waybar",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%; pkill -SIGRTMIN+1 waybar",
    "tooltip": false
  },
  "clock": {
    "format": "{:%a %d-%m %T}",
    "interval": 1,
    "tooltip": false
  },
  "tray": {
    "icon-size": 22,
    "spacing": 8
  }
}
